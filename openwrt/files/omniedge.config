# OmniEdge configuration for OpenWrt
#
# Edit this file or use UCI commands:
#   uci set omniedge.omniedge.enabled=1
#   uci set omniedge.omniedge.network_id='your-network-id'
#   uci set omniedge.omniedge.secret_key='your-secret-key'
#   uci commit omniedge
#
# Then restart the service:
#   /etc/init.d/omniedge restart

config omniedge 'omniedge'
	# Enable/disable the service (0=disabled, 1=enabled)
	option enabled '0'
	
	# Network ID from OmniEdge connect
	# Get this from: https://connect.omniedge.io
	option network_id ''
	
	# Secret key for this device
	# Get this from: omniedge login (on a device with a browser)
	# Or from the OmniEdge dashboard
	option secret_key ''
	
	# Log level: trace, debug, info, warn, error
	option log_level 'info'
	
	# Exit node for IPv4 traffic (optional)
	# Use another device's virtual IP as exit node
	# option exit_node '100.64.0.1'
	
	# Exit node for IPv6 traffic (optional)
	# option exit_node_v6 'fd00::1'
