{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniEdge",
  "version": "2.2.0",
  "identifier": "io.omniedge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniEdge",
        "width": 320,
        "height": 480,
        "minWidth": 320,
        "minHeight": 200,
        "maxWidth": 320,
        "maxHeight": 700,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "shadow": true,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "externalBin": [
      "binaries/omni-helper"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsi"
      }
    }
  }
}